# Points gcloud and Terraform at floci-gcp (Google Cloud simulated in Docker
# on your machine) instead of real Google Cloud. Load it into your shell with:
#   source scripts/floci-gcp.env
# It only changes the shell you source it in. Open a new terminal, or run
# `env | grep CLOUDSDK_` to see what it set.

export FLOCI_GCP="${FLOCI_GCP:-http://localhost:4588}"

# The project everything lives in. floci-gcp creates it the first time you use it.
export CLOUDSDK_CORE_PROJECT="${CLOUDSDK_CORE_PROJECT:-bukka-prod}"
export CLOUDSDK_COMPUTE_REGION=us-central1
export CLOUDSDK_COMPUTE_ZONE=us-central1-a

# floci-gcp doesn't check credentials, but gcloud and Terraform insist on
# having some. This is a dummy token: it is not a secret and works nowhere else.
export CLOUDSDK_AUTH_ACCESS_TOKEN=floci-fake-token
export GOOGLE_OAUTH_ACCESS_TOKEN=floci-fake-token
export CLOUDSDK_CORE_DISABLE_PROMPTS=1
export CLOUDSDK_CORE_SHOULD_PROMPT_TO_ENABLE_API=false

# gcloud has no single endpoint setting: each API is pointed at floci-gcp.
export CLOUDSDK_API_ENDPOINT_OVERRIDES_COMPUTE="$FLOCI_GCP/compute/v1/"
export CLOUDSDK_API_ENDPOINT_OVERRIDES_STORAGE="$FLOCI_GCP/storage/v1/"
export CLOUDSDK_API_ENDPOINT_OVERRIDES_IAM="$FLOCI_GCP/"
export CLOUDSDK_API_ENDPOINT_OVERRIDES_PUBSUB="$FLOCI_GCP/"
export CLOUDSDK_API_ENDPOINT_OVERRIDES_CLOUDRESOURCEMANAGER="$FLOCI_GCP/"
export CLOUDSDK_API_ENDPOINT_OVERRIDES_SERVICEUSAGE="$FLOCI_GCP/"

# The billing account floci-gcp gives every project. Budgets hang off it.
export BUKKA_BILLING_ACCOUNT="${BUKKA_BILLING_ACCOUNT:-000000-000000-000000}"
